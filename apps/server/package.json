{
  "name": "@bee-agent/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/main.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@bee-agent/contracts": "workspace:*",
    "@bee-agent/event-store": "workspace:*",
    "@bee-agent/kernel": "workspace:*",
    "@bee-agent/plugin-storage-sqlite": "workspace:*",
    "@bee-agent/plugin-tool-calculator": "workspace:*",
    "@bee-agent/runtime": "workspace:*",
    "fastify": "^5.12.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@bee-agent/client": "workspace:*"
  }
}
