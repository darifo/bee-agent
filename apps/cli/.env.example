# =============================================================
# Bee Agent CLI 环境变量模板
# 复制为 .env 后填入真实值;.env 已被 .gitignore 忽略,不要提交
# bee 脚本通过 node --env-file-if-exists=.env 加载
# =============================================================

# ---- 必填:会话令牌,必须与 Host 启动时使用的一致 ----
BEE_AGENT_SESSION_TOKEN=local-development-token

# ---- 可选:Host 地址(默认 http://127.0.0.1:3000)----
# BEE_AGENT_URL=http://127.0.0.1:3000
