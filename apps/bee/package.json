{
  "name": "@bee-agent/bee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/main.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@bee-agent/knowledge": "workspace:*",
    "@bee-agent/model-providers": "workspace:*",
    "@bee-agent/plugin-storage-sqlite": "workspace:*",
    "@bee-agent/runtime": "workspace:*",
    "@bee-agent/thread": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "vitest": "^4.0.15"
  }
}
