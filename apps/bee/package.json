{
  "name": "@bee-agent/bee",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/main.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node --env-file-if-exists=.env dist/main.js"
  },
  "dependencies": {
    "@bee-agent/kanban": "workspace:*",
    "@bee-agent/kernel": "workspace:*",
    "@bee-agent/knowledge": "workspace:*",
    "@bee-agent/learning": "workspace:*",
    "@bee-agent/memory-bee": "workspace:*",
    "@bee-agent/memory-remote": "workspace:*",
    "@bee-agent/model-providers": "workspace:*",
    "@bee-agent/runtime": "workspace:*",
    "@bee-agent/storage-sqlite": "workspace:*",
    "@bee-agent/thread": "workspace:*",
    "@bee-agent/tool-command": "workspace:*",
    "@bee-agent/tool-mcp": "workspace:*",
    "@bee-agent/tool-python": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.12.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "vitest": "^4.0.15"
  }
}
