# =============================================================
# Bee Agent Host 环境变量模板
# 复制为 .env 后填入真实值;.env 已被 .gitignore 忽略,不要提交
# 启动脚本会通过 node --env-file-if-exists=.env 加载它
# 注意:环境变量只在启动时读取一次,修改本文件后需要重启 Host 才生效
# =============================================================

# ---- 必填:模型接入(OpenAI 兼容接口)----
BEE_AGENT_MODEL_API_KEY=sk-your-api-key-here
BEE_AGENT_MODEL_NAME=deepseek-chat
BEE_AGENT_MODEL_BASE_URL=https://api.deepseek.com

# ---- 必填(使用 CLI/Web 时):会话令牌 ----
# 不设时 Host 每次启动随机生成并只打印到日志,CLI/Web 无法连上;本地固定一个即可
BEE_AGENT_SESSION_TOKEN=local-development-token

# ---- 可选:监听地址 ----
# BEE_AGENT_HOST=127.0.0.1
# BEE_AGENT_PORT=3000

# ---- 可选:统一个人数据目录 ----
# 默认 macOS: ~/Library/Application Support/bee-agent
#      Linux: $XDG_DATA_HOME/bee-agent 或 ~/.local/share/bee-agent
# SQLite 等持久产物默认落在其中;显式设置文件名时仍以其为准
# BEE_AGENT_DATA_DIR=/absolute/path/to/bee-data

# ---- 可选:SQLite 数据文件 ----
# BEE_AGENT_STORAGE_SQLITE_FILENAME=bee-agent.sqlite

# ---- 可选:远程记忆(WF4-C)----
# 设置后 Host 改用远程记忆服务(HTTP transport + 断路器 + 健康事件持久化),
# 未设置时使用内嵌 memory-bee。服务端需实现 /memory/* REST 契约
# BEE_AGENT_MEMORY_REMOTE_URL=http://127.0.0.1:4100
# BEE_AGENT_MEMORY_REMOTE_TOKEN=optional-bearer-token

# ---- 可选:结构热重载 ----
# 指向一个 EffectiveStructure JSON 文件;文件变更自动调和出新 generation,
# 失败时保留当前 generation(GET /structure 可查看调和状态)
# BEE_AGENT_STRUCTURE_FILE=/absolute/path/to/structure.json

# ---- 可选:外部工具(默认关闭,不配置则不进模型上下文)----
# 三者都要求原生可执行文件的绝对路径;当前平台沙箱禁止网络访问

# Command 工具:允许的原生可执行文件逗号分隔
# BEE_AGENT_COMMAND_EXECUTABLES=/bin/echo,/usr/bin/git
# BEE_AGENT_COMMAND_WORKSPACE=/absolute/path/to/workspace
# BEE_AGENT_COMMAND_MAX_TIMEOUT_MS=30000
# BEE_AGENT_COMMAND_MAX_OUTPUT_BYTES=1048576

# Python 工具:固定原生解释器(不要用 /usr/bin/python3 开发者工具 shim)
# BEE_AGENT_PYTHON_EXECUTABLE=/absolute/path/to/native/python3
# BEE_AGENT_PYTHON_WORKSPACE=/absolute/path/to/workspace
# BEE_AGENT_PYTHON_RUNTIME_READ_PATHS=/absolute/path/to/python/runtime
# BEE_AGENT_PYTHON_MAX_INPUT_BYTES=1048576
# BEE_AGENT_PYTHON_MAX_TIMEOUT_MS=30000
# BEE_AGENT_PYTHON_MAX_OUTPUT_BYTES=1048576

# MCP stdio 工具:JSON 数组,工具 schema/路径/secret/资源作用域全由 Host 固定
# BEE_AGENT_MCP_MANIFESTS=[{"name":"local","protocolVersion":"2024-11-05","executable":"/absolute/path/to/native/node","arguments":["/workspace/server.mjs"],"workspaceRoot":"/workspace","runtimeReadPaths":["/absolute/path/to/node/runtime"],"readPaths":["server.mjs"],"writePaths":[],"tools":[{"name":"lookup","description":"Look up local data","inputSchema":{"type":"object","properties":{"query":{"type":"string"}},"required":["query"],"additionalProperties":false}}]}]

# ---- 可选:准确时间服务(默认开启)----
# 本地时钟 + HTTP Date 头网络校准;每次模型请求注入当前时间,time_now 工具可随时查询
# 默认时区 Asia/Shanghai (UTC+8)
# BEE_AGENT_TIMEZONE=Asia/Shanghai
# 网络校准源(逗号分隔,取第一个响应的 Date 头;默认百度/淘宝)
# BEE_AGENT_TIME_SOURCES=https://www.baidu.com,https://www.taobao.com

# ---- 可选:网络检索工具(web_fetch / web_search,默认关闭)----
# web_fetch 只读 GET、响应限量;origin 白名单由 Host 审核后写死,模型无法自选
# BEE_AGENT_WEB_ALLOWED_ORIGINS=https://www.bbc.com,https://zh.wikipedia.org,https://en.wikipedia.org

# web_search 需要配置一个检索后端(二选一):
# 1) SearxNG(自托管,本地优先):JSON API 实例地址
# BEE_AGENT_SEARCH_SEARXNG_URL=http://127.0.0.1:8888
# 2) Tavily(云服务):接口地址 + API Key(Key 只进 transport,不进事件与模型上下文)
# BEE_AGENT_SEARCH_TAVILY_URL=https://api.tavily.com
# BEE_AGENT_SEARCH_TAVILY_API_KEY=tvly-your-key-here
